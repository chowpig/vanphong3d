{
  "name": "my-office",
  "version": "0.4.0",
  "private": true,
  "description": "A 3D office for your Claude Code sessions that also looks after your Mac: live agents, approve from the office, RAM per session, forgotten dev servers, cleanup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khanh020905/my-office.git"
  },
  "homepage": "https://github.com/khanh020905/my-office#readme",
  "type": "module",
  "bin": {
    "my-office": "bin/cli.mjs"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "node bin/cli.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "smoke": "node scripts/smoke.mjs",
    "doctor": "node bin/cli.mjs doctor"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
